    for dx = -307, 0: fill mhalf1 shifted (dx,0); fill mhalf2 shifted (dx,0); endfor
    fill ibar; fill xhalf1; fill xhalf2;
    for i = 1 upto 3: fill orn[i] transformed mirror; fill orn[i]; endfor
  );
  draw logo scaled u; currentpicture := currentpicture shifted -llcorner currentpicture;
